{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bogestv0 MIXER",
  "version": "0.0.1",
  "identifier": "com.bogestv0.mixer",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bogestv0 MIXER",
        "width": 1360,
        "height": 840,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyNTY4ODg3QzAzRTM0RjUKUldUMU5EN0FoNGhXZ2xiS014WTUrUnRjcHdJdk1PSWhoRmpWRXhBVkpDcnB6azdTU0JweUlINHcK",
      "endpoints": [
        "https://github.com/Bogestv0/Bogestv0-MIXER/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
